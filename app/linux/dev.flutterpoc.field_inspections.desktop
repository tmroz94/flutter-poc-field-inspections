[Desktop Entry]
Type=Application
Name=Field Inspections
Comment=Flutter PoC - field inspections
# Set Exec to the built binary's absolute path when installing by hand
# (docs/setup.md, "Desktop deep links"). %u passes the opened link.
Exec=field_inspections %u
Terminal=false
Categories=Office;
MimeType=x-scheme-handler/fieldinspections;
StartupWMClass=dev.flutterpoc.field_inspections
